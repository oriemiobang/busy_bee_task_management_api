// Prisma schema file
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------- ENUMS --------------------

enum Auth_Provider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum Status_Enum {
  UPCOMING
  PROGRESS
  COMPLETED
}

enum Recurrence_Type {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Day_Of_Week {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum Notification_Type {
  TASK_DUE
  TASK_REMINDER
  TASK_COMPLETED
  RECURRING_TASK
  SYSTEM
}

// -------------------- MODELS --------------------

model User {
  id                Int              @id @default(autoincrement())
  name              String
  email             String           @unique
  password          String
  auth_provider     Auth_Provider
  profile_image_url String?          @default("https://zraflqvymigtirrotmko.supabase.co/storage/v1/object/public/busy_bee_bucket/avatars/2/wanderercreative-blank-profile-picture-973460_1280.png")
  
  // Relations
  tasks             Task[]           // Tasks assigned to user
  createdTasks      Task[]           @relation("CreatedTasks") // Tasks created by user
  notifications     Notification[]
  
  // Timestamps
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Notification preferences
  notificationEmail Boolean          @default(true)
  notificationPush  Boolean          @default(true)
  reminderMinutes   Int              @default(30)
  
  @@map("users")
}

model Task {
  id                  Int               @id @default(autoincrement())
  title               String
  description         String            @default("")
  start_time          DateTime
  deadline            DateTime?
  status              Status_Enum       @default(UPCOMING)
  
  // Recurrence fields
  recurrenceType      Recurrence_Type?  @default(ONCE)
  recurrenceInterval  Int?              @default(1)
  recurrenceDays      Day_Of_Week[]     @default([]) // ✅ Fixed optional list
  recurrenceDayOfMonth Int?             @default(1)
  recurrenceEndDate   DateTime?

  // Relations
  userId              Int
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdById         Int?
  createdBy           User?             @relation("CreatedTasks", fields: [createdById], references: [id])

  subtasks            SubTask[]
  notifications       Notification[]    @relation("TaskNotifications")
  occurrences         TaskOccurrence[]  // ✅ Opposite relation for TaskOccurrence

  // Timestamps
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Indexes
  @@index([userId, status])
  @@index([start_time])
  @@index([recurrenceType, recurrenceEndDate])
  @@map("tasks")
}

model SubTask {
  id        Int      @id @default(autoincrement())
  title     String
  isDone    Boolean  @default(false)
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([taskId])
  @@map("sub_tasks")
}

model Notification {
  id            Int                @id @default(autoincrement())
  title         String
  description   String
  type          Notification_Type  @default(SYSTEM)
  isRead        Boolean            @default(false)
  
  // Task relation
  taskId        Int?               // Nullable - not all notifications are task-related
  task          Task?              @relation("TaskNotifications", fields: [taskId], references: [id], onDelete: SetNull)
  
  // Relations
  userId        Int
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Timestamps
  triggerTime   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  // Action tracking
  actionUrl     String?
  actionType    String?
  
  @@index([userId, isRead])
  @@index([triggerTime])
  @@index([taskId])
  @@map("notifications")
}

model TaskOccurrence {
  id            Int        @id @default(autoincrement())
  taskId        Int
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  status        Status_Enum @default(UPCOMING)
  
  createdAt     DateTime   @default(now())
  completedAt   DateTime?

  @@index([taskId, occurrenceDate])
  @@index([occurrenceDate])
  @@unique([taskId, occurrenceDate])
  @@map("task_occurrences")
}
